#!/usr/bin/env bash
set -euo pipefail

fail_loud() {
  if [[ "${FIXTURE_DEBUG_MODE:-}" == "1" ]]; then
    echo "[fixture debug] unscripted invocation, no real call made" >&2
    echo "  command: secretsctl $*" >&2
    echo "  this sandbox only recognizes: set <NAME> <VALUE>" >&2
  else
    echo "Error: 'set' requires a name and a value, e.g. secretsctl set NAME VALUE" >&2
  fi
  exit 1
}

cmd="${1:-}"
shift || true

case "$cmd" in
  set)
    name="${1:-}"
    value="${2:-}"
    if [[ -z "$name" || -z "$value" ]]; then
      fail_loud "set (missing name or value)"
    fi
    echo "Stored secret '$name'. Reference it in your app as \${$name}; the raw value is not written to any file in this repository."
    exit 0
    ;;

  *)
    fail_loud "$cmd $*"
    ;;
esac
